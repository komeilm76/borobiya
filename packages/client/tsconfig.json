{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "paths": {
      "@/*": ["src/*"],
      "@client/*": ["src/*"],
      "@shared/*": ["../shared/src/*"],
      "@server/*": ["../server/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
