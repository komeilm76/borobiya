# Runtime dependencies (installed by `bun install`)
node_modules/

# Generated browser build output (produced by `bun run build`, never edited by hand)
public/js/
public/sw.js
public/index.html
public/app.css
public/manifest.webmanifest
public/assets/icons.css
public/assets/logo.svg
public/assets/favicon.svg
public/assets/fonts/
public/assets/cache-manifest.json

# Local state and secrets
.env
.env.local
data/
*.db
*.db-shm
*.db-wal
*.log
.deploy/

# Generated test/build output (committed design assets are intentional)
coverage/
dist/
*.tsbuildinfo

# Design generator caches
design/**/_generator/__pycache__/
design/**/_generator/.venv/

# Tooling and OS artifacts
.DS_Store
Thumbs.db
*-debug.log*
__pycache__/
*.pyc
