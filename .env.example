# Local-development defaults only. Copy to .env and replace the placeholders.
# Never commit .env or use these placeholder credentials in production.

# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://borobiya:change-me@localhost:5432/borobiya
# OPENAPI_SERVER_PATH is intentionally unset: host API defaults to /, Compose to /api.
# Set it only if the public reverse-proxy prefix changes (not an API route prefix).
# Optional initial admin password. Setup stores it as base64 in this local-only .env
# so Unicode/special characters remain safe for both Bash and Compose parsing.
ADMIN_SEED_PASSWORD_B64=
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-this-with-a-different-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
# VM production helper sets this from a validated public HTTPS origin for the Caddy edge.
# Leave blank for development; it is not an API browser URL or TLS certificate path.
PUBLIC_DOMAIN=
# Comma-separated trusted reverse-proxy IPs/CIDRs for X-Forwarded-For; leave empty for direct access.
# Never use a world-wide range such as 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_IPS=

# Docker Compose (local defaults; change the PostgreSQL password before deployment).
# Use a URL-safe password (e.g. `openssl rand -hex 24`) because Compose builds DATABASE_URL from it;
# scripts/setup-ubuntu-vm.sh asks for both database passwords and accepts only that alphabet.
POSTGRES_USER=borobiya
POSTGRES_PASSWORD=change-me
POSTGRES_DB=borobiya
POSTGRES_PORT=5432
API_PORT=3000
MAP_SERVER_PORT=8000
MAP_ROUTING_PORT=8001
# Absolute external directory of staged Skadi HGT tiles + manifest.json; leave blank to disable elevation.
# Stage with: python3 map-server/scripts/stage-elevation.py --bbox "$MAP_BBOX" --dir "$MAP_ELEVATION_DIR"
MAP_ELEVATION_DIR=
NOMINATIM_HTTP_PORT=8081
NOMINATIM_DB_PORT=5433
# Import-only Nominatim profile: 'full' creates the data Photon needs; not a runtime browser service.
NOMINATIM_IMPORT_STYLE=full
# Replace before enabling the geocoding-import profile; bind ports stay on localhost.
NOMINATIM_PASSWORD=replace-with-a-random-password
# Conservative settings for a 6 GB development VM; raise only if memory allows.
NOMINATIM_THREADS=2
NOMINATIM_SHM_SIZE=1g
NOMINATIM_POSTGRES_SHARED_BUFFERS=512MB
NOMINATIM_POSTGRES_MAINTENANCE_WORK_MEM=1GB
NOMINATIM_POSTGRES_AUTOVACUUM_WORK_MEM=128MB
NOMINATIM_POSTGRES_WORK_MEM=32MB
NOMINATIM_POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
PHOTON_PORT=2322
PHOTON_JAVA_TOOL_OPTIONS="-Xms256m -Xmx1536m"
NGINX_PORT=8080

# Global rate-limit default: 100 requests per 60 seconds per IP.
# Route-specific limits (for example, auth and SOS) are enforced separately.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Location and SOS retention / limits
# The API's maintenance jobs consume the two location values: history rows older than the
# retention window are pruned once a day (batched), and LOCATION_HISTORY_MAX_SHARE_DAYS is the
# widest window one account may hand to another. Startup fails if the share window exceeds
# retention, because such a grant would promise points that had already been pruned.
# The SOS photo settings are read by `POST /_user/sos/requests/:id/photo`. Planned SOS auto-expiry
# and mission-timeout knobs are NOT implemented; do not add misleading values for them here.
LOCATION_HISTORY_RETENTION_DAYS=90
LOCATION_HISTORY_MAX_SHARE_DAYS=30
# Points a history read returns when the grant stores no maxPoints of its own (1-10000).
LOCATION_HISTORY_READ_POINTS=1000
# Largest SOS photo the API accepts, in megabytes (1-100, 1 MB = 1,048,576 bytes). The spec's figure is
# 5; raising it is a deliberate override and every refusal quotes the configured number.
SOS_PHOTO_MAX_SIZE_MB=5
# Where SOS photos are written. A relative path is anchored at this repository root, so the default is
# the gitignored `data/uploads/`; containers pass an absolute path beside their mounted volume (§9).
UPLOAD_DIR=data/uploads

# Independent Map Server (server-to-server URLs for local development)
MAP_SERVER_URL=http://localhost:8000
# Project-independent map library. Blank means setup uses
# ${XDG_DATA_HOME:-$HOME/.local/share}/borobiya/map-library and writes the
# resolved absolute paths below. Map content is organized there by
# continent/country/source or city/snapshot date; generated datasets contain
# the merged PBF, PMTiles, OSRM graphs, and Photon index for offline launch.
MAP_LIBRARY_DIR=
MAP_DATASET_DIR=
MAP_DATA_DIR=
MAP_OSRM_DATA_DIR=
MAP_PHOTON_DATA_DIR=
# Snapshot request: pinned (default), latest, or YYYY-MM-DD. Setup resolves
# latest to a concrete date and persists it, so ordinary reruns do not drift.
MAP_SNAPSHOT=pinned
MAP_SNAPSHOT_DATE=2026-10-18
# Source handling: cache-first (default), refresh, or offline.
MAP_SOURCE_POLICY=cache-first
# Selected map areas: comma-separated IDs from map-server/regions.json
# (whole countries like "ir"/"de" and/or cities like "ir-tehran,de-Frankfurt";
# list them with: python3 map-server/scripts/regions.py list).
# scripts/setup-ubuntu-vm.sh manages this via its selection form/--regions.
MAP_REGION_IDS=ir-tehran
# Stable dataset slug for generated archive/graph names and public map config.
MAP_REGION=borobiya
# Union of the selected areas' WGS84 west,south,east,north bounds.
# setup-ubuntu-vm.sh keeps this in sync with MAP_REGION_IDS.
MAP_BBOX=51.0,35.5,51.7,35.9
# The repository catalog pin is the 2026-10-18 Geofabrik snapshot. Other
# dates use Geofabrik's dated files and official .md5 sidecars; every source
# is verified before it enters the library.
# Must exactly match `osmium --version`; 1.16.0 is Ubuntu 24.04's apt osmium-tool.
MAP_OSMIUM_VERSION=1.16.0
# Planetiler's three global reference layers (Natural Earth, OSM lake centerlines, OSM water polygons) are
# cached once per map library instead of per dataset, because they do not depend on the area selection.
# Blank means the default: <MAP_LIBRARY_DIR>/planetiler-sources. generate-tiles.sh fetches anything missing
# and refuses with the exact paths when it cannot, so MAP_SOURCE_POLICY=offline means "tiles too".
MAP_PLANETILER_SOURCES_DIR=
# Mirror overrides. A set value replaces the public URL completely — there is no fallback to it, so an
# internal mirror is also the way to stop a build waiting on a host your network cannot reach.
MAP_NATURAL_EARTH_URL=
MAP_LAKE_CENTERLINES_URL=
MAP_WATER_POLYGONS_URL=
# Proxy: never put proxy values in .env. If needed, see the Proxy section
# in docs/UBUNTU_VM_RUNBOOK.md.
# Photon default language follows the first selected area (setup keeps in sync).
PHOTON_DEFAULT_LANGUAGE=fa
# Memory-conscious build/runtime limits for a 6 GB VM.
PLANETILER_HEAP=3g
OSRM_BUILD_THREADS=2
OSRM_RUNTIME_THREADS=1
# Setup writes the active library dataset PBF here; all pipelines consume it.
MAP_PBF=
# Version slug recorded with generated tiles and exposed by GET /map-config.
# Setup keeps this equal to MAP_SNAPSHOT_DATE.
MAP_DATA_VERSION=2026-10-18
# Planetiler 0.10.2 generates tile zoom 0-16; existing styles request through z14.
MAP_MIN_ZOOM=0
MAP_MAX_ZOOM=14
# Camera ceiling only: z14 tiles are overzoomed above z14 (no new geometry is invented).
MAP_VIEW_MAX_ZOOM=18
# Styles are not configured here: the client resolves the theme to the same-origin /map/style/{light,dark}
# paths, which Nginx proxies to Martin. There is deliberately no MAP_STYLE_* variable — a key nothing
# reads is a promise the app does not keep.
MAP_ROUTING_URL=http://localhost:8001/route
MAP_GEOCODE_URL=http://localhost:8001/geocode
MAP_REVERSE_URL=http://localhost:8001/reverse

# Vite's server-side proxy target is not exposed to browser code.
API_PROXY_TARGET=http://127.0.0.1:3000

# Browser-facing clients use same-origin paths (/api, /map, /route, /geocode, /reverse), never localhost URLs.
# The Vite and production reverse proxies forward these to local services.
VITE_API_URL=/api
VITE_MAP_URL=/map
