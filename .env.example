# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATA_DIR=./data

# Security
SESSION_TTL_SECONDS=86400
REALTIME_TICKET_TTL_SECONDS=20
MAX_BODY_BYTES=262144
COOKIE_SECURE=0
TRUST_PROXY=0
ALLOWED_ORIGINS=
SEED_DEMO_USERS=1

# Bootstrap administrator. Set a unique password of at least 12 characters before deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-production

# Operational limits
LOCATION_RETENTION_HOURS=168
WS_HEARTBEAT_MS=25000
WS_MAX_FRAME_BYTES=65536
