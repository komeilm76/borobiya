{
  "name": "borobiya",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Borobiya — Bun-native offline location, SOS and dispatch platform with a Vue 3 client",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "assets": "bun scripts/build-assets.ts",
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/boro.ts dev",
    "start": "bun src/server/index.ts",
    "setup": "bun scripts/boro.ts setup",
    "doctor": "bun scripts/boro.ts doctor",
    "typecheck": "bun run typecheck:server && bun run typecheck:client",
    "typecheck:server": "bunx tsc -p tsconfig.server.json",
    "typecheck:client": "bunx vue-tsc -p tsconfig.client.json --noEmit",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest",
    "coverage": "bunx --bun vitest run --coverage",
    "check": "bun scripts/boro.ts check",
    "verify": "bun scripts/boro.ts verify",
    "bench": "bun scripts/bench.ts",
    "smoke": "bun scripts/smoke.ts",
    "acceptance": "bun scripts/acceptance.ts",
    "docs:check": "bun scripts/check-docs.ts",
    "deploy:check": "bun scripts/boro.ts deploy:check",
    "db:seed": "bun scripts/boro.ts db:seed",
    "db:reset": "bun scripts/boro.ts db:reset",
    "clean": "bun scripts/boro.ts clean"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "@vueuse/motion": "^3.0.3",
    "gsap": "^3.15.1",
    "motion-v": "^2.11.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "sass": "^1.108.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
