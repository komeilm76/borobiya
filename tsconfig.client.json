{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "types": [],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["public/js/**/*.js"],
  "exclude": ["node_modules", "data", "dist", "coverage", "public/sw.js"]
}
